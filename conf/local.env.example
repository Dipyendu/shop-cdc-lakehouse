# Copy to conf/local.env (gitignored) and fill in. Read by scripts/with-secrets.sh.
# File with DATABRICKS_HOST and DATABRICKS_TOKEN (keep it outside the repository or gitignored).
SHOP_SECRETS_FILE="$HOME/.config/shop-cdc/secrets.env"
# SQL warehouse HTTP path: Databricks UI > SQL Warehouses > your warehouse > Connection details.
SHOP_WAREHOUSE_HTTP_PATH="/sql/1.0/warehouses/<warehouse-id>"
# Optional: a log file shared with other projects on the same workspace. A job run is refused
# while its last "QUOTA-STOP" line has no later "QUOTA-RESUME" line. Leave empty to disable.
SHOP_RUN_STOP_LOG=""
